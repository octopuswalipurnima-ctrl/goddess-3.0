# ==============================================================================
# GODDESS AI 2.0 - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your deployment-specific variables.
# NEVER commit real credentials, API keys, secrets, or passwords to git!

# --- Application ---
APP_NAME=Goddess AI 2.0
APP_VERSION=2.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# --- Server & CORS ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Production Security & JWT Authentication ---
# In production, SECRET_KEY must be a cryptographically random 32+ character string.
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-32-character-secret-key-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ISSUER=goddess-ai-2.0
JWT_AUDIENCE=goddess-dashboard
AUTH_ENABLED=true
AUTH_DEV_BYPASS=false

# Bootstrap Creator Credentials (used on clean install before registration)
BOOTSTRAP_CREATOR_USERNAME=creator
BOOTSTRAP_CREATOR_PASSWORD=

# --- Rate Limiting ---
AUTH_RATE_LIMIT_PER_MINUTE=10
EMERGENCY_RATE_LIMIT_PER_MINUTE=20
GENERAL_RATE_LIMIT_PER_MINUTE=120

# --- Persistence (PostgreSQL / SQLite) ---
# For Production: postgresql+asyncpg://user:password@host:5432/goddess_db
# For Local Dev Fallback (if empty): sqlite+aiosqlite:///./goddess_local.db
DATABASE_URL=

# Database Connection Pool
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30

# --- Redis (Transient State, Cooldowns & Deduplication) ---
# For Production: redis://default:password@host:6379/0
# If empty, automatically falls back to in-memory transient state manager
REDIS_URL=

# --- YouTube Data API v3 Keys (Up to 4 slots for rotation) ---
YOUTUBE_API_KEY_1=
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=
YOUTUBE_API_KEY_4=

# --- Google Gemini AI API Keys (Up to 4 slots for rotation) ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# AI Model Configuration
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_RETRIES=2
GEMINI_TIMEOUT_SECONDS=10.0
GEMINI_MAX_CONCURRENCY=5
GEMINI_QUEUE_MAX_SIZE=500

# Controlled Real Integration Testing (Opt-In Only)
RUN_REAL_YOUTUBE_TEST=false
RUN_REAL_GEMINI_TEST=false
TEST_YOUTUBE_STREAM_ID=
