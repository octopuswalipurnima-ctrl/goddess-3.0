# ============================================================
# GODDESS AI 3.0 (HONNEY) — CONFIGURATION
# ============================================================

# Database Connection (PostgreSQL with asyncpg driver)
# In Railway: Link DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Application Environment (production / development / test)
APP_ENV=production
PORT=8000

# ------------------------------------------------------------
# 4 Gemini API Keys (For key rotation, load balancing & quota failover)
# ------------------------------------------------------------
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# ------------------------------------------------------------
# 3 YouTube Data API v3 Keys (Read-only for public search & chat polling)
# ------------------------------------------------------------
YOUTUBE_API_KEY_1=
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=

# ------------------------------------------------------------
# Google OAuth 2.0 (For authenticated write ops: chat replies, deletions, bans)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth2callback

YOUTUBE_OAUTH_TOKEN=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# ------------------------------------------------------------
# WebSub / PubSubHubbub Stream Detection
# ------------------------------------------------------------
WEBSUB_CALLBACK_URL=
WEBSUB_SECRET=

# ------------------------------------------------------------
# Optional Notifications (Discord Webhook for HITL / Alerts)
# ------------------------------------------------------------
DISCORD_MOD_WEBHOOK_URL=
