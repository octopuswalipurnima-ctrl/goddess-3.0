# ============================================================
# GODDESS AI 3.0 (HONNEY) — CONFIGURATION
# ============================================================

# Database Connection (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/goddess_ai

# Application Port (Used by FastAPI & Railway)
PORT=8000

# ------------------------------------------------------------
# 4 Gemini API Keys (For key rotation, load balancing & quota failover)
# ------------------------------------------------------------
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY_4=your_gemini_api_key_4

# ------------------------------------------------------------
# 3 YouTube Data API v3 Keys (Read-only for public search & chat polling)
# ------------------------------------------------------------
YOUTUBE_API_KEY_1=your_youtube_api_key_1
YOUTUBE_API_KEY_2=your_youtube_api_key_2
YOUTUBE_API_KEY_3=your_youtube_api_key_3

# ------------------------------------------------------------
# Google OAuth 2.0 (For authenticated write ops: chat replies, deletions, bans)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth2callback

YOUTUBE_OAUTH_TOKEN=your_initial_oauth_access_token
YOUTUBE_OAUTH_REFRESH_TOKEN=your_oauth_refresh_token

# ------------------------------------------------------------
# WebSub / PubSubHubbub Stream Detection
# ------------------------------------------------------------
WEBSUB_CALLBACK_URL=https://your-railway-app.up.railway.app/websub/youtube
WEBSUB_SECRET=your_websub_hmac_secret_here

# ------------------------------------------------------------
# Optional Notifications (Discord Webhook for HITL / Alerts)
# ------------------------------------------------------------
DISCORD_MOD_WEBHOOK_URL=
