# ==============================================================================
# GODDESS AI 2.0 - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
APP_NAME="Goddess AI 2.0"
APP_VERSION="2.0.0"
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated list or JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL) - Optional during Milestone 0 & 1
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Cache / Coordination (Redis) - Optional during Milestone 0 & 1
# Format: redis://:<password>@<host>:<port>/<db_number>
REDIS_URL=

# YouTube Data API Credentials (Supports up to 4 rotated keys)
YOUTUBE_API_KEY_1=
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=
YOUTUBE_API_KEY_4=

# Gemini AI API Credentials (Supports up to 4 rotated keys)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Gemini AI Model & Performance Configuration
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_REQUEST_TIMEOUT=10.0
GEMINI_MAX_CONCURRENCY=2
GEMINI_QUEUE_MAX_SIZE=100
GEMINI_RATE_LIMIT_CAPACITY=5
GEMINI_RATE_LIMIT_REFILL_RATE=0.5
GEMINI_MAX_RETRIES=3

# Security & Authentication (Generate a strong random 32+ character string in production)
SECRET_KEY=development-insecure-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
